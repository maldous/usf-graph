# ---------------------------------------------------------------------------
# usf-factory — model-provider credential template
# ---------------------------------------------------------------------------
# The REAL secret file lives OUTSIDE this repository at /root/.env
#   - owned by root
#   - mode 0600
#   - never printed, logged, committed, or stored in SQLite
#
# This example lists only the CANONICAL variable NAMES the factory understands.
# Do NOT put real values here. Use scripts/import-provider-env.py to populate
# /root/.env from the outer environment through an exact allowlist.
#
# See docs/credential-import.md for the full alias table and precedence rules.
# ---------------------------------------------------------------------------

# --- API-token providers (stored in /root/.env when a usable value exists) ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
SAMBANOVA_API_KEY=
HF_TOKEN=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
ARCEE_TOKEN=

# GitHub: a general PAT does NOT imply Models permission. github-models is not
# admitted until a read-only probe proves the Models scope. Both names are
# canonical; keep them distinct.
GITHUB_MODELS_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional. Local Ollama normally needs no key.
OLLAMA_API_KEY=

# Disabled until supplied. xai-grok stays disabled without this.
XAI_API_KEY=

# Disabled unless later supplied. Never invent this value.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# The following are NEVER stored here by the factory:
#   STARDOG_TOKEN / STARDOG_* : the factory uses the /usf USF MCP boundary,
#     which loads /usf/.env itself. Do NOT copy Stardog credentials here.
#   Any unrelated service credential (Linear, Sentry, Atlassian, Netlify, ...).
#   AIS_API_KEY : unmapped candidate; recorded by name only, never imported.
# ---------------------------------------------------------------------------
#
# CLI / OIDC adapters use existing CLI authentication, NOT env tokens:
#   codex-cli  -> existing Codex/ChatGPT authentication
#   claude-cli -> existing Claude authentication
# Do not place OAuth/OIDC bearer tokens in this file.
