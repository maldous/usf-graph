# Sanitized configuration template for the USF semantic-authority endpoint.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# STARDOG_SERVER must be an https Stardog Cloud endpoint. The connection loader
# rejects http, localhost and loopback addresses, so a local server will not be
# accepted. The host is deliberately a placeholder: a Stardog Cloud Free
# endpoint is reclaimed after an inactivity window and its hostname changes on
# reprovisioning, so no specific host is durable enough to record here.
#
# See operations/stardog/provision-authority-endpoint.mjs to rebuild the
# database on a replacement endpoint, and
# operations/stardog/keepalive-authority-endpoint.mjs to keep an existing one
# from being reclaimed.
STARDOG_SERVER=https://<your-endpoint>.stardog.cloud:5820

# Database name. The compiler manifest (semantic-model/manifest.yaml) declares
# this same value as authoritative; keep the two in agreement.
STARDOG_DATABASE=USF

# Authentication. A token takes precedence over username/password.
# Tokens issued by a Stardog endpoint are audience-bound to that exact endpoint
# and become useless when it is reprovisioned — reissue after provisioning.
STARDOG_USERNAME=
STARDOG_PASSWORD=
STARDOG_TOKEN=

# Operator-owned content-addressed store for evidence payloads, outside Git.
USF_CAS_ROOT=/var/lib/usf-cas
