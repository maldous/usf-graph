shp:AuthorityConflictResolutionShape a sh:NodeShape;
    usf:canonicalName "authorityconflictresolutionshape";
    sh:targetSubjectsOf usf:resolvesAuthorityConflict;
    sh:property [ sh:path usf:canonicalName; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 1 ];
    sh:property [ sh:path usf:resolvesAuthorityConflict; sh:minCount 1; sh:maxCount 1; sh:class usf:AssuranceFinding ];
    sh:property [ sh:path usf:authorityConflictResolutionOwnerAssignment; sh:minCount 1; sh:maxCount 1; sh:class usf:OwnerAssignment ];
    sh:property [ sh:path usf:semanticCorrectionDecisionState; sh:minCount 1; sh:maxCount 1; sh:class usf:SemanticCorrectionDecisionState ];
    sh:property [ sh:path usf:decisionBasedOnSemanticAdequacyReview; sh:minCount 1; sh:maxCount 1; sh:class usf:SemanticAdequacyReview ];
    sh:property [ sh:path usf:warrantedBySemanticAdequacyProof; sh:minCount 1; sh:maxCount 1; sh:class usf:ProofResult ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "accepted authority-conflict resolution requires exact current review, exact successful proof subject and admitted active owner envelope";
      sh:select """SELECT $this WHERE {
        $this usf:semanticCorrectionDecisionState <urn:usf:semanticcorrectiondecisionstate:accepted> ;
              usf:resolvesAuthorityConflict ?conflict ;
              usf:semanticCorrectionDecisionState ?decisionState ;
              usf:decisionBasedOnSemanticAdequacyReview ?review ;
              usf:warrantedBySemanticAdequacyProof ?result ;
              usf:authorityConflictResolutionOwnerAssignment ?owner .
        ?conflict usf:conflictAuthorityDigest ?authority ; usf:conflictCandidateDigest ?candidate ; usf:conflictRepository ?repository .
        FILTER(
          ?decisionState != <urn:usf:semanticcorrectiondecisionstate:accepted> ||
          NOT EXISTS { ?review usf:hasSemanticAdequacyReviewState <urn:usf:semanticadequacyreviewstate:accepted> ; usf:reviewedAuthorityDigest ?authority ; usf:reviewedInventoryDigest ?candidate } ||
          NOT EXISTS { ?result usf:hasProofResultState <urn:usf:proofresultstate:successful> ; usf:resultForProof/usf:provesSubject ?conflict } ||
          NOT EXISTS { ?owner usf:assignmentState \"active\" ; usf:authorityRepository ?repository ; usf:hasAdmittedEnvelopeVerification/usf:envelopeVerificationState <urn:usf:resultstate:passed> }
        )
      }"""
    ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "one authority conflict may have at most one accepted resolution";
      sh:select """SELECT $this WHERE {
        $this usf:semanticCorrectionDecisionState <urn:usf:semanticcorrectiondecisionstate:accepted> ; usf:resolvesAuthorityConflict ?conflict .
        ?other usf:semanticCorrectionDecisionState <urn:usf:semanticcorrectiondecisionstate:accepted> ; usf:resolvesAuthorityConflict ?conflict .
        FILTER(?other != $this)
      }"""
    ].
