    sh:property [ sh:path usf:sourceScopeDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:assignmentCandidateDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:assignmentAuthorityPreDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:signedEnvelopeDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:assignmentState; sh:minCount 1; sh:maxCount 1; sh:in ( "pending-verification" "active" ) ];
    sh:property [ sh:path usf:ownerAssignmentSourcePath ];
    sh:property [ sh:path usf:hasAdmittedEnvelopeVerification ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "ownerassignmentscope: active assignment must bind at least one exact source path and one admitted envelope verification";
      sh:select "SELECT $this WHERE { $this usf:assignmentState \"active\" . FILTER(!EXISTS { $this usf:ownerAssignmentSourcePath ?path } || !EXISTS { $this usf:hasAdmittedEnvelopeVerification ?verification }) }"
    ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "ownerassignmentverification: active assignment fields and exact source-path set must equal its admitted envelope verification";
      sh:select "SELECT $this WHERE { $this usf:assignmentState \"active\" ; usf:authorityPrincipal ?principal ; usf:authoritySigningIdentity ?identity ; usf:authorityDomain ?domain ; usf:authorityRepository ?repository ; usf:sourceScopeDigest ?scopeDigest ; usf:assignmentCandidateDigest ?candidateDigest ; usf:assignmentAuthorityPreDigest ?preDigest ; usf:signedEnvelopeDigest ?envelopeDigest ; usf:hasAdmittedEnvelopeVerification ?verification . FILTER(!EXISTS { ?verification a usf:SemanticProofEnvelopeVerification ; usf:verificationForOwnerAssignment $this ; usf:verifiedBySemanticProofProtocol <urn:usf:semanticproofprotocol:v1> ; usf:verifiedAuthorityPrincipal ?principal ; usf:verifiedAuthoritySigningIdentity ?identity ; usf:verifiedAuthorityDomain ?domain ; usf:verifiedAuthorityRepository ?repository ; usf:verifiedSourceScopeDigest ?scopeDigest ; usf:verifiedAssignmentCandidateDigest ?candidateDigest ; usf:verifiedAssignmentAuthorityPreDigest ?preDigest ; usf:verifiedEnvelopeDigest ?envelopeDigest ; usf:envelopeVerificationState <urn:usf:resultstate:passed> ; usf:verifiedByExternalVerifier ?externalVerifier ; usf:hasEnvelopeVerificationAdmission ?admission ; usf:verificationCASDescriptor ?descriptor ; usf:envelopeVerificationReceiptDigest ?receipt . ?externalVerifier a usf:SemanticProofExternalVerifier ; usf:externalVerifierIdentity ?verifierIdentity . ?admission a usf:SemanticProofEnvelopeVerificationAdmission ; usf:admitsEnvelopeVerification ?verification ; usf:admittedVerificationCASDescriptor ?descriptor ; usf:verificationAdmissionState <urn:usf:resultstate:passed> ; usf:verificationAdmissionReceiptDigest ?admissionReceipt . ?descriptor a usf:SemanticProofVerificationCASDescriptor ; usf:semanticProofCASVerificationState <urn:usf:resultstate:passed> ; usf:semanticProofCASDescriptorReceiptDigest ?descriptorReceipt . } || EXISTS { $this usf:ownerAssignmentSourcePath ?path . FILTER NOT EXISTS { ?verification usf:verifiedOwnerAssignmentSourcePath ?path } } || EXISTS { ?verification usf:verifiedOwnerAssignmentSourcePath ?path . FILTER NOT EXISTS { $this usf:ownerAssignmentSourcePath ?path } }) }"
    ].

shp:SemanticProofEnvelopeVerificationShape a sh:NodeShape;
    usf:canonicalName "semanticproofenvelopeverificationshape";
    sh:targetClass usf:SemanticProofEnvelopeVerification;
    sh:property [ sh:path usf:verificationForOwnerAssignment; sh:minCount 1; sh:maxCount 1; sh:class usf:OwnerAssignment ];
    sh:property [ sh:path usf:verifiedBySemanticProofProtocol; sh:minCount 1; sh:maxCount 1; sh:hasValue <urn:usf:semanticproofprotocol:v1> ];
    sh:property [ sh:path usf:verifiedAuthorityPrincipal; sh:minCount 1; sh:maxCount 1; sh:class usf:SemanticAuthorityPrincipal ];
    sh:property [ sh:path usf:verifiedAuthoritySigningIdentity; sh:minCount 1; sh:maxCount 1; sh:class usf:SemanticAuthoritySigningIdentity ];
    sh:property [ sh:path usf:verifiedAuthorityDomain; sh:minCount 1; sh:maxCount 1; sh:class usf:CapabilityOwnerRole ];
    sh:property [ sh:path usf:verifiedAuthorityRepository; sh:minCount 1; sh:maxCount 1 ];
    sh:property [ sh:path usf:verifiedOwnerAssignmentSourcePath; sh:minCount 1 ];
    sh:property [ sh:path usf:verifiedSourceScopeDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:verifiedAssignmentCandidateDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:verifiedAssignmentAuthorityPreDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:verifiedEnvelopeDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:envelopeVerificationState; sh:minCount 1; sh:maxCount 1; sh:hasValue <urn:usf:resultstate:passed> ];
    sh:property [ sh:path usf:envelopeVerificationAdmissionState ];
    sh:property [ sh:path usf:verifiedByExternalVerifier; sh:minCount 1; sh:maxCount 1; sh:class usf:SemanticProofExternalVerifier ];
    sh:property [ sh:path usf:hasEnvelopeVerificationAdmission; sh:minCount 1; sh:maxCount 1; sh:class usf:SemanticProofEnvelopeVerificationAdmission ];
    sh:property [ sh:path usf:verificationCASDescriptor; sh:minCount 1; sh:maxCount 1; sh:class usf:SemanticProofVerificationCASDescriptor ];
    sh:property [ sh:path usf:envelopeVerifiedAt; sh:minCount 1; sh:maxCount 1; sh:datatype <http://www.w3.org/2001/XMLSchema#dateTime> ];
    sh:property [ sh:path usf:envelopeVerificationReceiptDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ].

shp:SemanticProofExternalVerifierIdentityShape a sh:NodeShape;
    usf:canonicalName "semanticproofexternalverifieridentityshape";
    sh:targetClass usf:SemanticProofExternalVerifierIdentity;
    sh:property [ sh:path usf:externalVerifierIdentityDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:externalVerifierTrustAnchorDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:not [ sh:class usf:SigningIdentity ].

shp:SemanticProofExternalVerifierShape a sh:NodeShape;
    usf:canonicalName "semanticproofexternalverifiershape";
    sh:targetClass usf:SemanticProofExternalVerifier;
    sh:property [ sh:path usf:externalVerifierIdentity; sh:minCount 1; sh:maxCount 1; sh:class usf:SemanticProofExternalVerifierIdentity ];
    sh:property [ sh:path usf:externalVerifierImplementationRelease; sh:minCount 1; sh:maxCount 1 ];
    sh:property [ sh:path usf:externalVerifierRepository; sh:minCount 1; sh:maxCount 1 ];
    sh:property [ sh:path usf:externalVerifierSourceHead; sh:minCount 1; sh:maxCount 1; sh:pattern "^[0-9a-f]{40}$" ];
    sh:property [ sh:path usf:externalVerifierSourceTree; sh:minCount 1; sh:maxCount 1; sh:pattern "^[0-9a-f]{40}$" ];
    sh:property [ sh:path usf:externalVerifierSourcePath; sh:minCount 1 ];
    sh:property [ sh:path usf:externalVerifierSourceScopeDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ].

shp:SemanticProofVerificationCASDescriptorShape a sh:NodeShape;
    usf:canonicalName "semanticproofverificationcasdescriptorshape";
    sh:targetClass usf:SemanticProofVerificationCASDescriptor;
    sh:property [ sh:path usf:semanticProofCASDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:semanticProofCASByteLength; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 0 ];
    sh:property [ sh:path usf:semanticProofCASMediaType; sh:minCount 1; sh:maxCount 1 ];
    sh:property [ sh:path usf:semanticProofCASVerificationState; sh:minCount 1; sh:maxCount 1; sh:hasValue <urn:usf:resultstate:passed> ];
    sh:property [ sh:path usf:semanticProofCASDescriptorReceiptDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ].

shp:SemanticProofEnvelopeVerificationAdmissionShape a sh:NodeShape;
    usf:canonicalName "semanticproofenvelopeverificationadmissionshape";
    sh:targetClass usf:SemanticProofEnvelopeVerificationAdmission;
    sh:property [ sh:path usf:admitsEnvelopeVerification; sh:minCount 1; sh:maxCount 1; sh:class usf:SemanticProofEnvelopeVerification ];
    sh:property [ sh:path usf:verificationAdmissionUsesEvidencePath; sh:minCount 1; sh:maxCount 1; sh:class usf:EvidenceAdmissionPath ];
    sh:property [ sh:path usf:admittedVerificationCASDescriptor; sh:minCount 1; sh:maxCount 1; sh:class usf:SemanticProofVerificationCASDescriptor ];
    sh:property [ sh:path usf:verificationAdmissionState; sh:minCount 1; sh:maxCount 1; sh:hasValue <urn:usf:resultstate:passed> ];
    sh:property [ sh:path usf:verificationAdmissionReceiptDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ].

shp:ExactProofObligationResultMappingShape a sh:NodeShape;
    usf:canonicalName "exactproofobligationresultmappingshape";
    sh:targetSubjectsOf usf:satisfiedByProofResult;
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "proofobligationmapping: result must explicitly name the same obligation";
      sh:select "SELECT $this WHERE { $this usf:satisfiedByProofResult ?result . FILTER NOT EXISTS { ?result usf:proofResultForObligation $this } }"
    ].

shp:ProofResultObligationUniquenessShape a sh:NodeShape;
    usf:canonicalName "proofresultobligationuniquenessshape";
    sh:targetClass usf:AggregateProofResult;
    sh:property [ sh:path usf:proofResultForObligation; sh:minCount 1; sh:maxCount 1; sh:class usf:ProofObligation ].

shp:ComponentProofRequirementShape a sh:NodeShape;
    usf:canonicalName "componentproofrequirementshape";
    sh:targetClass usf:ComponentProofRequirement;
    sh:property [ sh:path usf:componentObligation; sh:minCount 1; sh:maxCount 1; sh:nodeKind sh:IRI ];
    sh:property [ sh:path usf:componentProofResult; sh:minCount 1; sh:maxCount 1; sh:class usf:ProofResult ];
    sh:property [ sh:path usf:componentDimension; sh:minCount 1; sh:maxCount 1 ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "aggregatecomponentmapping: component result must explicitly and uniquely name its component obligation";
      sh:select "SELECT $this WHERE { $this usf:componentObligation ?obligation ; usf:componentProofResult ?result . FILTER NOT EXISTS { ?result usf:proofResultForObligation ?obligation . FILTER NOT EXISTS { ?result usf:proofResultForObligation ?other . FILTER(?other != ?obligation) } } }"
    ].

shp:AggregateProofObligationShape a sh:NodeShape;
    usf:canonicalName "aggregateproofobligationshape";
    sh:targetClass usf:AggregateProofObligation;
    sh:property [ sh:path usf:requiresComponentProof; sh:minCount 4; sh:maxCount 4; sh:class usf:ComponentProofRequirement ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "aggregateproofset: every exact compiler component obligation/result/dimension pair must occur once";
      sh:select "SELECT $this WHERE { FILTER(NOT EXISTS { $this usf:requiresComponentProof ?imported . ?imported usf:componentObligation <urn:usf:proofobligation:importedauthoritycounterfactualadequacy> ; usf:componentProofResult <urn:usf:proofresult:importedauthoritycounterfactualadequacy> ; usf:componentDimension \"importedauthoritycounterfactualadequacy\" . } || NOT EXISTS { $this usf:requiresComponentProof ?live . ?live usf:componentObligation <urn:usf:proofobligation:compilerliveauthoritycontrol> ; usf:componentProofResult <urn:usf:proofresult:compilerliveauthoritycontrol> ; usf:componentDimension \"liveauthoritycontrol\" . } || NOT EXISTS { $this usf:requiresComponentProof ?contract . ?contract usf:componentObligation <urn:usf:proofobligation:p10cc239b81b3890d5714e8996d369bd08394965220eae7c34aa7c3ccbfc2467b> ; usf:componentProofResult <urn:usf:proofresult:compilercontractbehaviour> ; usf:componentDimension \"compilercontractbehaviour\" . } || NOT EXISTS { $this usf:requiresComponentProof ?hermetic . ?hermetic usf:componentObligation <urn:usf:proofobligation:compilersemantics> ; usf:componentProofResult <urn:usf:proofresult:compilerhermeticsubstitute> ; usf:componentDimension \"hermeticsubstitutebehaviour\" . }) }"
    ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "aggregateproofset: unexpected or mismatched compiler component is forbidden";
      sh:select "SELECT $this WHERE { $this usf:requiresComponentProof ?requirement . ?requirement usf:componentObligation ?obligation ; usf:componentProofResult ?result ; usf:componentDimension ?dimension . FILTER(!((?obligation = <urn:usf:proofobligation:importedauthoritycounterfactualadequacy> && ?result = <urn:usf:proofresult:importedauthoritycounterfactualadequacy> && ?dimension = \"importedauthoritycounterfactualadequacy\") || (?obligation = <urn:usf:proofobligation:compilerliveauthoritycontrol> && ?result = <urn:usf:proofresult:compilerliveauthoritycontrol> && ?dimension = \"liveauthoritycontrol\") || (?obligation = <urn:usf:proofobligation:p10cc239b81b3890d5714e8996d369bd08394965220eae7c34aa7c3ccbfc2467b> && ?result = <urn:usf:proofresult:compilercontractbehaviour> && ?dimension = \"compilercontractbehaviour\") || (?obligation = <urn:usf:proofobligation:compilersemantics> && ?result = <urn:usf:proofresult:compilerhermeticsubstitute> && ?dimension = \"hermeticsubstitutebehaviour\"))) }"
    ].

shp:AggregateProofResultShape a sh:NodeShape;
    usf:canonicalName "aggregateproofresultshape";
    sh:targetClass usf:AggregateProofResult;
    sh:property [ sh:path usf:proofResultForObligation; sh:minCount 1; sh:maxCount 1; sh:class usf:AggregateProofObligation ];
    sh:property [ sh:path usf:componentSetDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:aggregateAlgorithmDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:aggregateSourceHead; sh:minCount 1; sh:maxCount 1; sh:pattern "^[0-9a-f]{40}$" ];
    sh:property [ sh:path usf:aggregateAuthorityDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ].

shp:PostPublicationAggregateProofResultShape a sh:NodeShape;
    usf:canonicalName "postpublicationaggregateproofresultshape";
    sh:targetClass usf:PostPublicationAggregateProofResult;
    sh:property [ sh:path usf:resultState; sh:minCount 1; sh:maxCount 1; sh:hasValue <urn:usf:resultstate:passed> ];
    sh:property [ sh:path usf:hasFreshness; sh:minCount 1; sh:maxCount 1; sh:hasValue <urn:usf:freshness:fresh> ];
    sh:property [ sh:path usf:hasPostPublicationReevaluation; sh:minCount 1; sh:maxCount 1; sh:class usf:PostPublicationReevaluation ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "postpublicationaggregate: reevaluation must produce this result and bind identical authority, source, algorithm and component digests";
      sh:select "SELECT $this WHERE { $this usf:hasPostPublicationReevaluation ?reevaluation ; usf:aggregateAuthorityDigest ?authority ; usf:aggregateSourceHead ?source ; usf:aggregateAlgorithmDigest ?algorithm ; usf:componentSetDigest ?components . FILTER NOT EXISTS { ?reevaluation usf:reevaluationProducesProofResult $this ; usf:reevaluationAuthorityDigest ?authority ; usf:reevaluationSourceHead ?source ; usf:reevaluationAlgorithmDigest ?algorithm ; usf:reevaluationComponentSetDigest ?components ; usf:reevaluationResultState <urn:usf:resultstate:passed> . } }"
    ].

shp:PostPublicationReevaluationShape a sh:NodeShape;
    usf:canonicalName "postpublicationreevaluationshape";
    sh:targetClass usf:PostPublicationReevaluation;
    sh:property [ sh:path usf:reevaluatesProofResult; sh:minCount 1; sh:maxCount 1; sh:class usf:PrePublicationAggregateProofResult ];
    sh:property [ sh:path usf:reevaluatesValidationResult; sh:maxCount 1; sh:class usf:ValidationResult ];
    sh:property [ sh:path usf:reevaluationProducesProofResult; sh:minCount 1; sh:maxCount 1; sh:class usf:PostPublicationAggregateProofResult ];
    sh:property [ sh:path usf:reevaluationAuthorityDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:reevaluationSourceHead; sh:minCount 1; sh:maxCount 1; sh:pattern "^[0-9a-f]{40}$" ];
    sh:property [ sh:path usf:reevaluationAlgorithmDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:reevaluationComponentSetDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:reevaluationResultState; sh:minCount 1; sh:maxCount 1; sh:hasValue <urn:usf:resultstate:passed> ];
    sh:property [ sh:path usf:reevaluationEvaluatedAt; sh:minCount 1; sh:maxCount 1; sh:datatype <http://www.w3.org/2001/XMLSchema#dateTime> ];
    sh:property [ sh:path usf:reevaluationExecutionReceiptDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:reevaluationEvaluationReceiptDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "postpublicationreevaluation: authority digest must change while source, algorithm and exact component set remain bound";
      sh:select "SELECT $this WHERE { $this usf:reevaluatesProofResult ?before ; usf:reevaluationProducesProofResult ?after ; usf:reevaluationAuthorityDigest ?newAuthority ; usf:reevaluationSourceHead ?source ; usf:reevaluationAlgorithmDigest ?algorithm ; usf:reevaluationComponentSetDigest ?components . ?before usf:aggregateAuthorityDigest ?oldAuthority ; usf:aggregateSourceHead ?source ; usf:aggregateAlgorithmDigest ?algorithm ; usf:componentSetDigest ?components . FILTER(?before = ?after || ?oldAuthority = ?newAuthority) }"
    ].

shp:AggregateContractDirectBindingShape a sh:NodeShape;
    usf:canonicalName "aggregatecontractdirectbindingshape";
    sh:targetClass usf:SemanticContract;
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "aggregatecontractbinding: a contract with an aggregate obligation must directly select exactly one matching post-publication aggregate result and no component result";
      sh:select "SELECT $this WHERE { $this usf:mandatoryProofObligation ?aggregate . ?aggregate a usf:AggregateProofObligation . { FILTER NOT EXISTS { $this usf:reliesOnProofResult ?selected . ?selected a usf:PostPublicationAggregateProofResult ; usf:proofResultForObligation ?aggregate . } } UNION { $this usf:reliesOnProofResult ?selected . FILTER NOT EXISTS { ?selected a usf:PostPublicationAggregateProofResult ; usf:proofResultForObligation ?aggregate . } } UNION { { SELECT $this (COUNT(DISTINCT ?selected) AS ?count) WHERE { $this usf:reliesOnProofResult ?selected } GROUP BY $this } FILTER(?count != 1) } }"
    ].

shp:ValidationProducerShape a sh:NodeShape;
    usf:canonicalName "validationproducershape";
    sh:targetClass usf:ValidationProducer;
    sh:property [ sh:path usf:validationProducerRepository; sh:minCount 1; sh:maxCount 1 ];
    sh:property [ sh:path usf:validationProducerRelease; sh:minCount 1; sh:maxCount 1 ];
    sh:property [ sh:path usf:validationProducerSourceHead; sh:minCount 1; sh:maxCount 1; sh:pattern "^[0-9a-f]{40}$" ];
    sh:property [ sh:path usf:validationProducerSourceTree; sh:minCount 1; sh:maxCount 1; sh:pattern "^[0-9a-f]{40}$" ];
    sh:property [ sh:path usf:validationProducerSourcePath; sh:minCount 1 ];
    sh:property [ sh:path usf:validationProducerSourceScopeDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ].

shp:EvidenceAdmissionPathShape a sh:NodeShape;
    usf:canonicalName "evidenceadmissionpathshape";
    sh:targetClass usf:EvidenceAdmissionPath;
    sh:property [ sh:path usf:admissionPathForProducer; sh:minCount 1; sh:maxCount 1; sh:class usf:ValidationProducer ];
    sh:property [ sh:path usf:admissionPathRepository; sh:minCount 1; sh:maxCount 1 ];
    sh:property [ sh:path usf:admissionPathSourceHead; sh:minCount 1; sh:maxCount 1; sh:pattern "^[0-9a-f]{40}$" ];
    sh:property [ sh:path usf:admissionPathSourceTree; sh:minCount 1; sh:maxCount 1; sh:pattern "^[0-9a-f]{40}$" ];
    sh:property [ sh:path usf:admissionPathSourcePath; sh:minCount 1 ];
    sh:property [ sh:path usf:admissionPathSourceScopeDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ].

shp:AggregateCandidateLifecycleTypeShape a sh:NodeShape;
    usf:canonicalName "aggregatecandidatelifecycletypeshape";
    sh:targetClass usf:AggregateProofAlgorithm;
    sh:targetClass usf:AggregateProofExecution;
    sh:targetClass usf:AggregateProofEvaluation;
    sh:targetClass usf:ValidationSelfPublicationAuthorityBinding.

shp:ValidationExecutionShape a sh:NodeShape;
    usf:canonicalName "validationexecutionshape";
    sh:targetClass usf:ValidationExecution;
    sh:property [ sh:path usf:validationExecutedByProducer ];
    sh:property [ sh:path usf:validationUsesEvidenceAdmissionPath ];
    sh:property [ sh:path usf:validationExecutionReceiptDigest ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "aggregatevalidationexecution: a materialised aggregate validation execution requires one producer, admission path and receipt digest";
      sh:select "SELECT $this WHERE { FILTER($this = <urn:usf:validationexecution:compilersemanticenforcementaggregate>) FILTER(NOT EXISTS { $this usf:validationExecutedByProducer ?producer . ?producer a usf:ValidationProducer . } || EXISTS { $this usf:validationExecutedByProducer ?left, ?right . FILTER(?left != ?right) } || NOT EXISTS { $this usf:validationUsesEvidenceAdmissionPath ?admissionPath . ?admissionPath a usf:EvidenceAdmissionPath . } || EXISTS { $this usf:validationUsesEvidenceAdmissionPath ?left, ?right . FILTER(?left != ?right) } || NOT EXISTS { $this usf:validationExecutionReceiptDigest ?receipt . FILTER(REGEX(STR(?receipt), '^sha256:[0-9a-f]{64}$')) } || EXISTS { $this usf:validationExecutionReceiptDigest ?left, ?right . FILTER(?left != ?right) }) }"
    ].

shp:ValidationEvaluationShape a sh:NodeShape;
    usf:canonicalName "validationevaluationshape";
    sh:targetClass usf:ValidationEvaluation;
    sh:property [ sh:path usf:validationEvaluationOfExecution; sh:minCount 1; sh:maxCount 1; sh:class usf:ValidationExecution ];
    sh:property [ sh:path usf:validationEvaluationReceiptDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ].

shp:ValidationEvidenceShape a sh:NodeShape;
    usf:canonicalName "validationevidenceshape";
    sh:targetClass usf:ValidationEvidence;
    sh:property [ sh:path usf:validationEvidenceForExecution ];
    sh:property [ sh:path usf:validationEvidenceAdmittedThrough ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "aggregatevalidationevidence: materialised aggregate validation evidence requires one execution and admission path";
      sh:select "SELECT $this WHERE { FILTER($this = <urn:usf:validationevidence:compilersemanticenforcementaggregate>) FILTER(NOT EXISTS { $this usf:validationEvidenceForExecution ?execution . ?execution a usf:ValidationExecution . } || EXISTS { $this usf:validationEvidenceForExecution ?left, ?right . FILTER(?left != ?right) } || NOT EXISTS { $this usf:validationEvidenceAdmittedThrough ?admissionPath . ?admissionPath a usf:EvidenceAdmissionPath . } || EXISTS { $this usf:validationEvidenceAdmittedThrough ?left, ?right . FILTER(?left != ?right) }) }"
    ].

shp:ValidationResultSelfPublicationClosureShape a sh:NodeShape;
    usf:canonicalName "validationresultselfpublicationclosureshape";
    sh:targetClass usf:ValidationResult;
    sh:property [ sh:path usf:validationResultOfEvaluation ];
    sh:property [ sh:path usf:hasValidationSelfPublicationAuthorityBinding ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "validationcurrentness: a fresh validation result requires successful admitted execution/evaluation evidence and complete self-publication authority closure";
      sh:select "SELECT $this WHERE { $this usf:hasFreshness <urn:usf:freshness:fresh> . FILTER NOT EXISTS { $this usf:resultState <urn:usf:resultstate:passed> ; usf:validationResultOfEvaluation ?evaluation ; usf:hasValidationSelfPublicationAuthorityBinding ?binding . ?evaluation a usf:ValidationEvaluation ; usf:validationEvaluationOfExecution ?execution ; usf:validationEvaluationReceiptDigest ?evaluationReceipt . ?execution a usf:ValidationExecution ; usf:validationExecutedByProducer ?producer ; usf:validationUsesEvidenceAdmissionPath ?admissionPath ; usf:validationExecutionReceiptDigest ?executionReceipt . ?evidence a usf:ValidationEvidence ; usf:validationEvidenceForExecution ?execution ; usf:validationEvidenceAdmittedThrough ?admissionPath . ?binding a usf:ValidationSelfPublicationBinding ; usf:authorityBindingForValidationResult $this ; usf:authorityBindingValidationProducer ?producer ; usf:authorityBindingEvidenceAdmissionPath ?admissionPath ; usf:validationBindingExecutionReceiptDigest ?executionReceipt ; usf:validationBindingEvaluationReceiptDigest ?evaluationReceipt ; usf:validationPostPublicationReevaluationState <urn:usf:resultstate:passed> ; usf:validationRequiresPostPublicationReevaluation true ; usf:validationUsesAuthorityBindingRule ?bindingRule ; usf:validationBindingEnvelopeVerification ?envelopeVerification ; usf:validationBindingExternalVerifier ?externalVerifier ; usf:validationBindingVerificationCASDescriptor ?descriptor . ?envelopeVerification usf:verifiedByExternalVerifier ?externalVerifier ; usf:verificationCASDescriptor ?descriptor ; usf:hasEnvelopeVerificationAdmission ?verificationAdmission . ?verificationAdmission usf:admitsEnvelopeVerification ?envelopeVerification ; usf:admittedVerificationCASDescriptor ?descriptor ; usf:verificationAdmissionState <urn:usf:resultstate:passed> . ?descriptor usf:semanticProofCASVerificationState <urn:usf:resultstate:passed> . } }"
    ].

shp:ValidationSelfPublicationAuthorityBindingShape a sh:NodeShape;
    usf:canonicalName "validationselfpublicationauthoritybindingshape";
    sh:targetClass usf:ValidationSelfPublicationBinding;
    sh:property [ sh:path usf:authorityBindingForValidationResult; sh:minCount 1; sh:maxCount 1; sh:class usf:ValidationResult ];
    sh:property [ sh:path usf:authorityBindingValidationProducer; sh:minCount 1; sh:maxCount 1; sh:class usf:ValidationProducer ];
    sh:property [ sh:path usf:authorityBindingEvidenceAdmissionPath; sh:minCount 1; sh:maxCount 1; sh:class usf:EvidenceAdmissionPath ];
    sh:property [ sh:path usf:validationStageOneEvaluatedAuthorityDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:validationNonPublicationDependencySetDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:validationNonPublicationDependencyDigestAlgorithm; sh:minCount 1; sh:maxCount 1 ];
    sh:property [ sh:path usf:validationPostPublicationReevaluationState; sh:minCount 1; sh:maxCount 1; sh:hasValue <urn:usf:resultstate:passed> ];
    sh:property [ sh:path usf:validationStageOneSettledAuthorityDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:validationReevaluationDependencyDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:validationBindingExecutionReceiptDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:validationBindingEvaluationReceiptDigest; sh:minCount 1; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:validationBindingProducerRelease; sh:minCount 1; sh:maxCount 1 ];
    sh:property [ sh:path usf:validationBindingRepository; sh:maxCount 1 ];
    sh:property [ sh:path usf:validationBindingSourceHead; sh:maxCount 1; sh:pattern "^[0-9a-f]{40}$" ];
    sh:property [ sh:path usf:validationBindingSourceTree; sh:maxCount 1; sh:pattern "^[0-9a-f]{40}$" ];
    sh:property [ sh:path usf:validationBindingSourcePath ];
    sh:property [ sh:path usf:validationBindingSourceScopeDigest; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:validationBindingProducerRepository; sh:maxCount 1 ];
    sh:property [ sh:path usf:validationBindingProducerSourceHead; sh:maxCount 1; sh:pattern "^[0-9a-f]{40}$" ];
    sh:property [ sh:path usf:validationBindingProducerSourceTree; sh:maxCount 1; sh:pattern "^[0-9a-f]{40}$" ];
    sh:property [ sh:path usf:validationBindingProducerSourcePath ];
    sh:property [ sh:path usf:validationBindingProducerSourceScopeDigest; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:validationBindingAdmissionRepository; sh:maxCount 1 ];
    sh:property [ sh:path usf:validationBindingAdmissionSourceHead; sh:maxCount 1; sh:pattern "^[0-9a-f]{40}$" ];
    sh:property [ sh:path usf:validationBindingAdmissionSourceTree; sh:maxCount 1; sh:pattern "^[0-9a-f]{40}$" ];
    sh:property [ sh:path usf:validationBindingAdmissionSourcePath ];
    sh:property [ sh:path usf:validationBindingAdmissionSourceScopeDigest; sh:maxCount 1; sh:pattern "^sha256:[0-9a-f]{64}$" ];
    sh:property [ sh:path usf:validationBindingPostPublicationReevaluation; sh:maxCount 1; sh:class usf:PostPublicationReevaluation ];
    sh:property [ sh:path usf:validationUsesAuthorityBindingRule; sh:minCount 1; sh:maxCount 1; sh:class usf:AuthorityBindingRule; sh:in ( <urn:usf:authoritybindingrule:validationnonpublicationdependencyclosure> <urn:usf:authoritybindingrule:validationcrossrepositorynonpublicationclosure> ) ];
    sh:property [ sh:path usf:validationRequiresPostPublicationReevaluation; sh:minCount 1; sh:maxCount 1; sh:hasValue true ];
    sh:property [ sh:path usf:validationBindingEnvelopeVerification; sh:minCount 1; sh:maxCount 1; sh:class usf:SemanticProofEnvelopeVerification ];
    sh:property [ sh:path usf:validationBindingExternalVerifier; sh:minCount 1; sh:maxCount 1; sh:class usf:SemanticProofExternalVerifier ];
    sh:property [ sh:path usf:validationBindingVerificationCASDescriptor; sh:minCount 1; sh:maxCount 1; sh:class usf:SemanticProofVerificationCASDescriptor ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "validationpublicationclosure: producer, admission, source scope and execution/evaluation receipt bindings must be exact";
      sh:select "SELECT $this WHERE { $this usf:validationUsesAuthorityBindingRule <urn:usf:authoritybindingrule:validationnonpublicationdependencyclosure> ; usf:authorityBindingForValidationResult ?result ; usf:authorityBindingValidationProducer ?producer ; usf:authorityBindingEvidenceAdmissionPath ?admissionPath ; usf:validationBindingExecutionReceiptDigest ?executionReceipt ; usf:validationBindingEvaluationReceiptDigest ?evaluationReceipt ; usf:validationBindingProducerRelease ?release ; usf:validationBindingRepository ?repository ; usf:validationBindingSourceHead ?head ; usf:validationBindingSourceTree ?tree ; usf:validationBindingSourceScopeDigest ?scopeDigest . FILTER(NOT EXISTS { ?result usf:validationResultOfEvaluation ?evaluation . ?evaluation usf:validationEvaluationOfExecution ?execution ; usf:validationEvaluationReceiptDigest ?evaluationReceipt . ?execution usf:validationExecutedByProducer ?producer ; usf:validationUsesEvidenceAdmissionPath ?admissionPath ; usf:validationExecutionReceiptDigest ?executionReceipt . ?producer usf:validationProducerRelease ?release ; usf:validationProducerRepository ?repository ; usf:validationProducerSourceHead ?head ; usf:validationProducerSourceTree ?tree ; usf:validationProducerSourceScopeDigest ?scopeDigest . ?admissionPath usf:admissionPathForProducer ?producer ; usf:admissionPathRepository ?repository ; usf:admissionPathSourceHead ?head ; usf:admissionPathSourceTree ?tree ; usf:admissionPathSourceScopeDigest ?scopeDigest . } || EXISTS { $this usf:validationBindingSourcePath ?path . FILTER(!EXISTS { ?producer usf:validationProducerSourcePath ?path } || !EXISTS { ?admissionPath usf:admissionPathSourcePath ?path }) } || EXISTS { ?producer usf:validationProducerSourcePath ?path . FILTER NOT EXISTS { $this usf:validationBindingSourcePath ?path } } || EXISTS { ?admissionPath usf:admissionPathSourcePath ?path . FILTER NOT EXISTS { $this usf:validationBindingSourcePath ?path } }) }"
    ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "validationpublicationclosure: cross-repository producer and admission identities must each bind exactly, with canonical reevaluation receipts";
      sh:select "SELECT $this WHERE { $this usf:validationUsesAuthorityBindingRule <urn:usf:authoritybindingrule:validationcrossrepositorynonpublicationclosure> . FILTER(NOT EXISTS { $this usf:authorityBindingForValidationResult ?result ; usf:authorityBindingValidationProducer ?producer ; usf:authorityBindingEvidenceAdmissionPath ?admissionPath ; usf:validationBindingExecutionReceiptDigest ?executionReceipt ; usf:validationBindingEvaluationReceiptDigest ?evaluationReceipt ; usf:validationBindingProducerRelease ?release ; usf:validationBindingProducerRepository ?producerRepository ; usf:validationBindingProducerSourceHead ?producerHead ; usf:validationBindingProducerSourceTree ?producerTree ; usf:validationBindingProducerSourceScopeDigest ?producerScope ; usf:validationBindingAdmissionRepository ?admissionRepository ; usf:validationBindingAdmissionSourceHead ?admissionHead ; usf:validationBindingAdmissionSourceTree ?admissionTree ; usf:validationBindingAdmissionSourceScopeDigest ?admissionScope ; usf:validationStageOneSettledAuthorityDigest ?settled ; usf:validationBindingPostPublicationReevaluation ?reevaluation . FILTER(?producerRepository != ?admissionRepository) ?result usf:validationResultOfEvaluation ?evaluation . ?evaluation usf:validationEvaluationOfExecution ?execution ; usf:validationEvaluationReceiptDigest ?evaluationReceipt . ?execution usf:validationExecutedByProducer ?producer ; usf:validationUsesEvidenceAdmissionPath ?admissionPath ; usf:validationExecutionReceiptDigest ?executionReceipt . ?producer usf:validationProducerRelease ?release ; usf:validationProducerRepository ?producerRepository ; usf:validationProducerSourceHead ?producerHead ; usf:validationProducerSourceTree ?producerTree ; usf:validationProducerSourceScopeDigest ?producerScope . ?admissionPath usf:admissionPathForProducer ?producer ; usf:admissionPathRepository ?admissionRepository ; usf:admissionPathSourceHead ?admissionHead ; usf:admissionPathSourceTree ?admissionTree ; usf:admissionPathSourceScopeDigest ?admissionScope . ?reevaluation a usf:PostPublicationReevaluation ; usf:reevaluatesValidationResult ?result ; usf:reevaluationAuthorityDigest ?settled ; usf:reevaluationResultState <urn:usf:resultstate:passed> ; usf:reevaluationExecutionReceiptDigest ?reevaluationExecutionReceipt ; usf:reevaluationEvaluationReceiptDigest ?reevaluationEvaluationReceipt . } || EXISTS { $this usf:validationBindingRepository|usf:validationBindingSourceHead|usf:validationBindingSourceTree|usf:validationBindingSourcePath|usf:validationBindingSourceScopeDigest ?legacySharedBinding }) }"
    ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "validationpublicationclosure: cross-repository producer source paths must form an exact set";
      sh:select "SELECT $this WHERE { $this usf:validationUsesAuthorityBindingRule <urn:usf:authoritybindingrule:validationcrossrepositorynonpublicationclosure> ; usf:authorityBindingValidationProducer ?producer . FILTER(EXISTS { $this usf:validationBindingProducerSourcePath ?path . FILTER NOT EXISTS { ?producer usf:validationProducerSourcePath ?path } } || EXISTS { ?producer usf:validationProducerSourcePath ?path . FILTER NOT EXISTS { $this usf:validationBindingProducerSourcePath ?path } }) }"
    ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "validationpublicationclosure: cross-repository admission source paths must form an exact set";
      sh:select "SELECT $this WHERE { $this usf:validationUsesAuthorityBindingRule <urn:usf:authoritybindingrule:validationcrossrepositorynonpublicationclosure> ; usf:authorityBindingEvidenceAdmissionPath ?admissionPath . FILTER(EXISTS { $this usf:validationBindingAdmissionSourcePath ?path . FILTER NOT EXISTS { ?admissionPath usf:admissionPathSourcePath ?path } } || EXISTS { ?admissionPath usf:admissionPathSourcePath ?path . FILTER NOT EXISTS { $this usf:validationBindingAdmissionSourcePath ?path } }) }"
    ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "validationpublicationclosure: stage-1 publication must settle a new authority digest";
      sh:select "SELECT $this WHERE { $this usf:validationStageOneEvaluatedAuthorityDigest ?evaluated ; usf:validationStageOneSettledAuthorityDigest ?settled . FILTER(?evaluated = ?settled) }"
    ];
    sh:sparql [
      sh:prefixes usf:prefixes;
      sh:message "validationpublicationclosure: authority closure requires the same externally verified, admitted CAS descriptor across validation and envelope verification";
      sh:select "SELECT $this WHERE { $this usf:validationBindingEnvelopeVerification ?verification ; usf:validationBindingExternalVerifier ?externalVerifier ; usf:validationBindingVerificationCASDescriptor ?descriptor . FILTER NOT EXISTS { ?verification a usf:SemanticProofEnvelopeVerification ; usf:verifiedByExternalVerifier ?externalVerifier ; usf:verificationCASDescriptor ?descriptor ; usf:hasEnvelopeVerificationAdmission ?admission . ?externalVerifier a usf:SemanticProofExternalVerifier ; usf:externalVerifierIdentity ?externalVerifierIdentity . ?admission a usf:SemanticProofEnvelopeVerificationAdmission ; usf:admitsEnvelopeVerification ?verification ; usf:admittedVerificationCASDescriptor ?descriptor ; usf:verificationAdmissionState <urn:usf:resultstate:passed> ; usf:verificationAdmissionReceiptDigest ?admissionReceipt . ?descriptor a usf:SemanticProofVerificationCASDescriptor ; usf:semanticProofCASVerificationState <urn:usf:resultstate:passed> ; usf:semanticProofCASDescriptorReceiptDigest ?descriptorReceipt . } }"
    ].
