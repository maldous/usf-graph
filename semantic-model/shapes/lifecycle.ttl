@prefix usf: <urn:usf:ontology:>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix admission: <urn:usf:evidenceadmissionstate:>.
@prefix freshnessstate: <urn:usf:evidencefreshnessstate:>.
@prefix integritystate: <urn:usf:evidenceintegritystate:>.
@prefix proofstate: <urn:usf:proofresultstate:>.
@prefix contractstate: <urn:usf:contractactivationstate:>.

<urn:usf:shape:proofobligationevidence> a sh:NodeShape;
    sh:targetClass usf:ProofObligation.
_:b38_b38_n3-556 sh:path usf:requiresEvidence;
    sh:minCount 1;
    sh:class usf:EvidenceRequirement.
<urn:usf:shape:proofobligationevidence> sh:property _:b38_b38_n3-556.
<urn:usf:shape:successfulproofresult> a sh:NodeShape;
    sh:targetClass usf:ProofResult.
_:b38_b38_n3-557 sh:message "Successful proof requires exact admitted fresh integrity-valid applicable evidence, a complete non-circular evidence pipeline, and evaluation metadata.";
    sh:select "PREFIX usf: <urn:usf:ontology:>\nPREFIX admission: <urn:usf:evidenceadmissionstate:>\nPREFIX freshnessstate: <urn:usf:evidencefreshnessstate:>\nPREFIX integritystate: <urn:usf:evidenceintegritystate:>\nPREFIX proofstate: <urn:usf:proofresultstate:>\nPREFIX resultstate: <urn:usf:resultstate:>\nPREFIX es: <urn:usf:evidencestage:>\nSELECT $this WHERE { $this usf:hasProofResultState proofstate:successful . FILTER (NOT EXISTS {$this usf:proofResultForObligation ?o} || NOT EXISTS {$this usf:usesAdmittedEvidence ?e} || NOT EXISTS {$this usf:evidenceSetDigest ?d} || NOT EXISTS {$this usf:usesProofAlgorithm ?a} || NOT EXISTS {$this usf:usesAlgorithmVersion ?v} || NOT EXISTS {$this usf:evaluatedByValidator ?validator} || NOT EXISTS {$this usf:proofExecutionEnvironment ?env} || NOT EXISTS {$this usf:hasConfidenceState ?c} || NOT EXISTS {$this usf:evaluatedAt ?t} || NOT EXISTS {$this usf:hasInvalidationCondition ?i} || EXISTS {$this usf:proofResultForObligation ?o ; usf:usesAdmittedEvidence ?e . FILTER (NOT EXISTS {?e usf:hasAdmissionState admission:admitted ; usf:hasFreshnessState freshnessstate:fresh ; usf:hasIntegrityState integritystate:valid ; usf:applicableToObligation ?o ; usf:withinValidityScope true} || NOT EXISTS {?e usf:evidenceStage es:emitted, es:collected, es:normalised, es:ingested, es:signed, es:integrityverified ; usf:collectedBy ?collection ; usf:normalisedBy ?normalisation ; usf:ingestedBy ?ingestion ; usf:evidenceSignature ?signature ; usf:evidenceChecksum ?checksum ; usf:integrityVerification ?verification . ?collection a usf:EvidenceCollection . ?normalisation a usf:EvidenceNormalisation . ?ingestion a usf:EvidenceIngestion . ?signature a usf:Signature . ?checksum a usf:Checksum . ?verification a usf:IntegrityVerification ; usf:verifiesEvidence ?e ; usf:verificationState resultstate:passed .})}) }".
<urn:usf:shape:successfulproofresult> sh:sparql _:b38_b38_n3-557.
<urn:usf:shape:evidenceboundconfidence> a sh:NodeShape;
    sh:targetSubjectsOf usf:hasConfidenceState.
_:b38_b38_n3-558 sh:message "Warranted confidence requires successful evidence-bound proof; reduced, withdrawn and unknown confidence remain explicit non-warranting states.";
    sh:select "PREFIX usf: <urn:usf:ontology:>\nPREFIX admission: <urn:usf:evidenceadmissionstate:>\nPREFIX freshnessstate: <urn:usf:evidencefreshnessstate:>\nPREFIX integritystate: <urn:usf:evidenceintegritystate:>\nPREFIX proofstate: <urn:usf:proofresultstate:>\nPREFIX confidence: <urn:usf:proofconfidencestate:>\nPREFIX contractstate: <urn:usf:contractactivationstate:>\nSELECT $this WHERE { $this usf:hasConfidenceState confidence:warranted . FILTER NOT EXISTS {$this a usf:ProofResult ; usf:hasProofResultState proofstate:successful ; usf:usesAdmittedEvidence ?e ; usf:confidenceBasis ?e} }".
<urn:usf:shape:evidenceboundconfidence> sh:sparql _:b38_b38_n3-558.
<urn:usf:shape:activecontractproof> a sh:NodeShape;
    sh:targetClass usf:SemanticContract.
_:b38_b38_n3-559 sh:message "Active contracts require current successful proof for every mandatory obligation.";
    sh:select "PREFIX usf: <urn:usf:ontology:>\nPREFIX admission: <urn:usf:evidenceadmissionstate:>\nPREFIX freshnessstate: <urn:usf:evidencefreshnessstate:>\nPREFIX integritystate: <urn:usf:evidenceintegritystate:>\nPREFIX proofstate: <urn:usf:proofresultstate:>\nPREFIX contractstate: <urn:usf:contractactivationstate:>\nSELECT $this WHERE { $this usf:hasActivationState contractstate:active . FILTER (NOT EXISTS {$this usf:mandatoryProofObligation ?o} || EXISTS {$this usf:mandatoryProofObligation ?o . FILTER NOT EXISTS {$this usf:reliesOnProofResult ?r . ?r usf:proofResultForObligation ?o ; usf:hasProofResultState proofstate:successful ; usf:usesAdmittedEvidence ?e ; usf:confidenceBasis ?e . ?e usf:hasAdmissionState admission:admitted ; usf:hasFreshnessState freshnessstate:fresh ; usf:hasIntegrityState integritystate:valid}}) }".
<urn:usf:shape:activecontractproof> sh:sparql _:b38_b38_n3-559.
<urn:usf:shape:implementablestatedefinition> a sh:NodeShape;
    sh:targetNode <urn:usf:realisationstate:implementable>.
_:b38_b38_n3-560 sh:path usf:canonicalName;
    sh:hasValue "implementable".
<urn:usf:shape:implementablestatedefinition> sh:property _:b38_b38_n3-560.
_:b38_b38_n3-561 sh:path usf:allowsRealisationPredecessor.
<urn:usf:shape:implementablestatedefinition> sh:property _:b38_b38_n3-561.
_:b38_b38_n3-562 sh:path usf:allowsRealisationSuccessor;
    sh:minCount 1;
    sh:class usf:RealisationState.
<urn:usf:shape:implementablestatedefinition> sh:property _:b38_b38_n3-562.
_:b38_b38_n3-563 sh:path usf:requiresContractActivationState;
    sh:hasValue contractstate:active.
<urn:usf:shape:implementablestatedefinition> sh:property _:b38_b38_n3-563.
_:b38_b38_n3-564 sh:path usf:requiresDecisionState;
    sh:hasValue <urn:usf:decisionstate:accepted>.
<urn:usf:shape:implementablestatedefinition> sh:property _:b38_b38_n3-564.
_:b38_b38_n3-565 sh:path usf:requiresRealisationType;
    sh:hasValue usf:Implementation.
<urn:usf:shape:implementablestatedefinition> sh:property _:b38_b38_n3-565.
_:b38_b38_n3-566 sh:path usf:requiresAuthorisedSourcePath;
    sh:hasValue true .
<urn:usf:shape:implementablestatedefinition> sh:property _:b38_b38_n3-566.
_:b38_b38_n3-567 sh:path usf:requiresExistingImplementation;
    sh:hasValue false .
<urn:usf:shape:implementablestatedefinition> sh:property _:b38_b38_n3-567.
<urn:usf:shape:implementablerealisation> a sh:NodeShape;
    sh:targetNode <urn:usf:ontology>.
_:b38_b38_n3-568 sh:message "Implementable realisation requires an active evidence-backed contract, successful proof, accepted decision, authorised implementation type and an exactly authorised path.";
    sh:select "PREFIX usf: <urn:usf:ontology:>\nPREFIX admission: <urn:usf:evidenceadmissionstate:>\nPREFIX freshnessstate: <urn:usf:evidencefreshnessstate:>\nPREFIX integritystate: <urn:usf:evidenceintegritystate:>\nPREFIX proofstate: <urn:usf:proofresultstate:>\nPREFIX contractstate: <urn:usf:contractactivationstate:>\nSELECT $this WHERE {\n  FILTER EXISTS {\n    ?realisation a usf:Realisation ; usf:realisationState <urn:usf:realisationstate:implementable> ; usf:realisesContract ?c .\n    FILTER NOT EXISTS {\n        ?c usf:hasActivationState contractstate:active ; usf:mandatoryProofObligation ?ob ;\n           usf:reliesOnProofResult ?pr ; usf:permittedRealisationType ?type .\n        ?pr usf:proofResultForObligation ?ob ; usf:hasProofResultState proofstate:successful ;\n            usf:usesAdmittedEvidence ?e ; usf:confidenceBasis ?e .\n        ?e usf:hasAdmissionState admission:admitted ; usf:hasFreshnessState freshnessstate:fresh ;\n           usf:hasIntegrityState integritystate:valid ; usf:applicableToObligation ?ob ; usf:withinValidityScope true .\n        ?realisation usf:authorisedByDecision ?d ; usf:authorisedSourcePath ?path .\n        ?d usf:decisionState <urn:usf:decisionstate:accepted> ; usf:authorisesRealisationType ?type .\n        { ?d usf:authorisesSourcePath ?path }\n        UNION\n        { ?c usf:decisionScopedMaterialisationRequired true ; usf:effectiveRealisationDecision ?d . ?d usf:authorisesSourceDirectory ?path }\n    }\n  }\n}".
<urn:usf:shape:implementablerealisation> sh:sparql _:b38_b38_n3-568.
<urn:usf:shape:validationevidenceentry> a sh:NodeShape;
    sh:targetClass usf:ValidationResult.
_:b38_b38_n3-569 sh:path usf:entersEvidenceLifecycleAs;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class usf:ValidationEvidence.
<urn:usf:shape:validationevidenceentry> sh:property _:b38_b38_n3-569.
<urn:usf:shape:proofalgorithmsource> a sh:NodeShape;
    sh:targetClass usf:ProofAlgorithm.
_:b38_b38_n3-570 sh:path usf:proofAlgorithmSourcePath;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:pattern "^assurance/[A-Za-z0-9._/-]+$".
<urn:usf:shape:proofalgorithmsource> sh:property _:b38_b38_n3-570.
_:b38_b38_n3-571 sh:path usf:proofAlgorithmSourceDigest;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:pattern "^sha256:[0-9a-f]{64}$".
<urn:usf:shape:proofalgorithmsource> sh:property _:b38_b38_n3-571.
_:proof_algorithm_source_set_digest sh:path usf:proofAlgorithmSourceSetDigest;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:pattern "^sha256:[0-9a-f]{64}$".
<urn:usf:shape:proofalgorithmsource> sh:property _:proof_algorithm_source_set_digest.
_:current_algorithm_source_set_digest sh:path usf:currentAlgorithmSourceSetDigest;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:pattern "^sha256:[0-9a-f]{64}$".
<urn:usf:shape:proofalgorithmsource> sh:property _:current_algorithm_source_set_digest.
<urn:usf:shape:proofalgorithmversionidentity> a sh:NodeShape;
    sh:targetClass usf:ProofAlgorithmVersion.
_:b38_b38_n3-572 sh:path usf:proofAlgorithmVersionOf;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class usf:ProofAlgorithm.
<urn:usf:shape:proofalgorithmversionidentity> sh:property _:b38_b38_n3-572.
_:b38_b38_n3-573 sh:path usf:proofAlgorithmVersionIdentifier;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:pattern "^[0-9]+[.][0-9]+[.][0-9]+$".
<urn:usf:shape:proofalgorithmversionidentity> sh:property _:b38_b38_n3-573.
_:proof_algorithm_version_source_set_digest sh:path usf:proofAlgorithmVersionSourceSetDigest;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:pattern "^sha256:[0-9a-f]{64}$".
<urn:usf:shape:proofalgorithmversionidentity> sh:property _:proof_algorithm_version_source_set_digest.
<urn:usf:shape:proofresultalgorithmsourceset> a sh:NodeShape;
    sh:targetClass usf:ProofResult.
_:proof_result_algorithm_source_set_digest sh:path usf:algorithmSourceSetDigest;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:pattern "^sha256:[0-9a-f]{64}$".
<urn:usf:shape:proofresultalgorithmsourceset> sh:property _:proof_result_algorithm_source_set_digest.
<urn:usf:shape:forbiddenshortcuts> a sh:NodeShape;
    sh:targetSubjectsOf usf:establishesSemanticTruth, usf:directlyActivatesContract, usf:directlyAdmitsEvidence, usf:directlyEstablishesProof.
_:b38_b38_n3-574 sh:message "ADR, external-work-record, report and test authority inversions are forbidden.";
    sh:select "PREFIX usf: <urn:usf:ontology:>\nPREFIX admission: <urn:usf:evidenceadmissionstate:>\nPREFIX freshnessstate: <urn:usf:evidencefreshnessstate:>\nPREFIX integritystate: <urn:usf:evidenceintegritystate:>\nPREFIX proofstate: <urn:usf:proofresultstate:>\nPREFIX contractstate: <urn:usf:contractactivationstate:>\nSELECT $this WHERE { {$this a usf:ADRRecord ; usf:establishesSemanticTruth ?x} UNION {$this a usf:ExternalWorkRecord ; usf:directlyActivatesContract ?x} UNION {$this a usf:Report ; usf:directlyAdmitsEvidence ?x} UNION {$this a usf:Test ; usf:directlyEstablishesProof ?x} }".
<urn:usf:shape:forbiddenshortcuts> sh:sparql _:b38_b38_n3-574.

# --- ValidationObligation lifecycle enforcement -----------------------------
# Each shape blocks one way a consumer could conclude "satisfied" without the
# full authoritative chain.

<urn:usf:shape:validationobligationstate> a sh:NodeShape;
    sh:targetClass usf:ValidationObligation;
    # semanticLifecycleState has rdfs:domain usf:SemanticContract. Asserting it
    # on an obligation is a domain violation and silently overloads one property
    # with activation, actionability and closure at once.
    sh:property [ sh:path usf:semanticLifecycleState; sh:maxCount 0;
        sh:message "a ValidationObligation must not use semanticLifecycleState; use usf:hasValidationActivationState" ];
    sh:property [ sh:path usf:hasValidationActivationState; sh:minCount 1; sh:maxCount 1;
        sh:class usf:ValidationObligationActivationState;
        sh:message "a ValidationObligation must declare exactly one activation state" ];
    sh:property [ sh:path usf:validationForContract; sh:minCount 1; sh:maxCount 1;
        sh:message "a ValidationObligation must bind exactly one contract" ].

<urn:usf:shape:validationresultbinding> a sh:NodeShape;
    sh:targetObjectsOf usf:satisfiedByValidationResult;
    # A passing result is not a satisfying result. Satisfaction requires exact
    # obligation binding, passing state, admitted evidence and current bindings.
    sh:property [ sh:path usf:resultForValidationObligation; sh:minCount 1; sh:maxCount 1;
        sh:class usf:ValidationObligation;
        sh:message "a satisfying ValidationResult must bind exactly one ValidationObligation" ];
    sh:property [ sh:path usf:resultState; sh:minCount 1; sh:hasValue <urn:usf:resultstate:passed>;
        sh:message "a satisfying ValidationResult must be passing" ];
    sh:property [ sh:path usf:usesAdmittedValidationEvidence; sh:minCount 1;
        sh:message "a satisfying ValidationResult must cite the admitted evidence it evaluated" ];
    sh:property [ sh:path usf:validationEvaluatedAuthorityDigest; sh:minCount 1; sh:maxCount 1;
        sh:message "a satisfying ValidationResult must bind the exact authority it was evaluated against" ];
    sh:property [ sh:path usf:validationEvaluatedSourceHead; sh:minCount 1; sh:maxCount 1;
        sh:message "a satisfying ValidationResult must bind the exact source head it was evaluated against" ];
    sh:property [ sh:path usf:hasValidationInvalidationCondition; sh:maxCount 0;
        sh:message "an invalidated ValidationResult must not continue to satisfy an obligation" ];
    sh:property [ sh:path usf:supersededByValidationResult; sh:maxCount 0;
        sh:message "a superseded ValidationResult must not continue to satisfy an obligation" ].

<urn:usf:shape:validationexecutiontargeting> a sh:NodeShape;
    sh:targetClass usf:ValidationExecution;
    sh:property [ sh:path usf:executesValidation; sh:minCount 1; sh:maxCount 1;
        sh:class usf:ValidationObligation;
        sh:message "a ValidationExecution must target exactly one ValidationObligation" ].

<urn:usf:shape:reservedvalidationobligationnotsatisfied> a sh:NodeShape;
    sh:targetClass usf:ValidationObligation;
    # A reserved or blocked obligation is not closeable, whatever results exist.
    sh:sparql [ sh:message "a reserved or blocked ValidationObligation must not be satisfied";
        sh:select """SELECT $this WHERE {
            $this <urn:usf:ontology:hasValidationActivationState> ?state .
            FILTER(?state IN (<urn:usf:validationactivationstate:reserved>,
                              <urn:usf:validationactivationstate:blocked>))
            $this <urn:usf:ontology:satisfiedByValidationResult> ?r .
        }""" ].

<urn:usf:shape:validationsatisfactionidentity> a sh:NodeShape;
    sh:targetClass usf:ValidationObligation;
    # Identity isolation: the satisfying result must name THIS obligation, not a
    # same-named or same-suffixed sibling from another obligation family.
    sh:sparql [ sh:message "a ValidationResult may only satisfy the exact obligation it binds";
        sh:select """SELECT $this WHERE {
            $this <urn:usf:ontology:satisfiedByValidationResult> ?r .
            ?r <urn:usf:ontology:resultForValidationObligation> ?bound .
            FILTER(?bound != $this)
        }""" ].

# --- Contract validation applicability enforcement --------------------------
# usf:requiredValidation is a positive-only statement. On its own, its absence
# is silence, and silence was readable as "not required". These shapes make the
# applicability of validation an explicit, exactly-once, closed decision for
# every governed contract, and make each state carry the evidence that state
# asserts.

# usf:SemanticContract is overloaded: AccessibilityProfile, ArtefactPlan,
# AutomationWorkflowContract, CompatibilityContract, LocalisationProfile,
# RendererContract, UISemanticModel and ViewModel are all rdfs:subClassOf it, so
# under the reasoning schema 128 descriptive nodes are SemanticContract
# instances. None of them carries an activation state, a mandatory proof
# obligation, a required validation or a declared facet. Those four marks are
# what make a contract governed, and only a governed contract can answer the
# applicability question, so they are the target discriminator here. A blanket
# targetClass would demand a lifecycle answer from a view model.
<urn:usf:shape:contractvalidationapplicability> a sh:NodeShape;
    sh:targetClass usf:SemanticContract;
    sh:property [ sh:path usf:hasValidationApplicability; sh:maxCount 1;
        sh:class usf:ValidationApplicabilityState;
        sh:message "validation applicability must be at most one state from the closed vocabulary" ];
    sh:sparql [ sh:message "a governed SemanticContract must declare exactly one validation applicability state and state its basis";
        sh:select """SELECT $this WHERE {
            { $this <urn:usf:ontology:hasActivationState> ?governedMark }
            UNION { $this <urn:usf:ontology:mandatoryProofObligation> ?governedMark }
            UNION { $this <urn:usf:ontology:requiredValidation> ?governedMark }
            UNION { $this <urn:usf:ontology:declaresFacet> ?governedMark }
            FILTER(NOT EXISTS { $this <urn:usf:ontology:hasValidationApplicability> ?declaredState }
                   || NOT EXISTS { $this <urn:usf:ontology:validationApplicabilityReason> ?declaredReason })
        }""" ].

<urn:usf:shape:validationapplicabilityclosure> a sh:NodeShape;
    sh:targetClass usf:SemanticContract;
    # required and reserved both assert that validation is in scope, so both
    # must name the exact obligations they are in scope for.
    sh:sparql [ sh:message "required or reserved validation applicability must bind at least one ValidationObligation that binds back to this contract";
        sh:select """SELECT $this WHERE {
            $this <urn:usf:ontology:hasValidationApplicability> ?state .
            FILTER(?state IN (<urn:usf:validationapplicabilitystate:required>,
                              <urn:usf:validationapplicabilitystate:reserved>))
            FILTER NOT EXISTS {
              $this <urn:usf:ontology:requiredValidation> ?obligation .
              ?obligation a <urn:usf:ontology:ValidationObligation> ;
                <urn:usf:ontology:validationForContract> $this .
            }
        }""" ];
    # An exemption is a positive claim. It needs positive proof authority and
    # must not simultaneously carry obligations it claims not to have.
    sh:sparql [ sh:message "notRequired validation applicability requires successful-proof authority and no bound ValidationObligation";
        sh:select """SELECT $this WHERE {
            $this <urn:usf:ontology:hasValidationApplicability> <urn:usf:validationapplicabilitystate:notrequired> .
            FILTER(EXISTS { $this <urn:usf:ontology:requiredValidation> ?bound }
                   || NOT EXISTS {
                        $this <urn:usf:ontology:validationApplicabilityAuthority> ?authority .
                        ?authority a <urn:usf:ontology:ProofResult> ;
                          <urn:usf:ontology:hasProofResultState> <urn:usf:proofresultstate:successful> .
                      })
        }""" ];
    sh:sparql [ sh:message "conditional validation applicability requires at least one fully structured condition";
        sh:select """SELECT $this WHERE {
            $this <urn:usf:ontology:hasValidationApplicability> <urn:usf:validationapplicabilitystate:conditional> .
            FILTER NOT EXISTS {
              $this <urn:usf:ontology:validationApplicabilityCondition> ?condition .
              ?condition <urn:usf:ontology:conditionSubject> ?conditionSubject ;
                <urn:usf:ontology:conditionPredicate> ?conditionPredicate ;
                <urn:usf:ontology:conditionRequiredValue> ?conditionValue .
            }
        }""" ];
    # unresolved means "not yet classifiable". It must not smuggle in either an
    # obligation set or an exemption, both of which are resolved conclusions.
    sh:sparql [ sh:message "unresolved validation applicability must not bind a ValidationObligation or cite exemption authority";
        sh:select """SELECT $this WHERE {
            $this <urn:usf:ontology:hasValidationApplicability> <urn:usf:validationapplicabilitystate:unresolved> .
            FILTER(EXISTS { $this <urn:usf:ontology:requiredValidation> ?bound }
                   || EXISTS { $this <urn:usf:ontology:validationApplicabilityAuthority> ?authority })
        }""" ];
    # The converse leak: obligations present while applicability denies or
    # defers them.
    sh:sparql [ sh:message "a contract binding a ValidationObligation must declare required, reserved or conditional applicability";
        sh:select """SELECT $this WHERE {
            $this <urn:usf:ontology:requiredValidation> ?obligation .
            FILTER NOT EXISTS {
              $this <urn:usf:ontology:hasValidationApplicability> ?state .
              FILTER(?state IN (<urn:usf:validationapplicabilitystate:required>,
                                <urn:usf:validationapplicabilitystate:reserved>,
                                <urn:usf:validationapplicabilitystate:conditional>))
            }
        }""" ].
