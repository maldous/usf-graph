<urn:usf:realisationoption:authenticatedcheckpointcoldarchiveboundedhottail> a usf:RealisationOption, usf:ComposedRealisationOption;
    usf:canonicalName "authenticatedcheckpointcoldarchiveboundedhottail";
    usf:definition "Authenticated event-history checkpoint plus immutable signed cold archive and a bounded verified hot tail, preserving exact archive and genesis restoration.".
<urn:usf:realisationoption:genesisreplayhotstoreonly> a usf:RealisationOption;
    usf:canonicalName "genesisreplayhotstoreonly";
    usf:definition "Retain the complete immutable event history in the hot operational store and verify by replay from genesis without checkpoint activation or prefix archiving.".
<urn:usf:realisationdecision:backupandrestoreeventhistorycheckpointpruning> a usf:RealisationDecision;
    usf:canonicalName "backupandrestoreeventhistorycheckpointpruning";
    usf:decisionState <urn:usf:decisionstate:accepted>;
    usf:decisionForContract sc:backupandrestore;
    usf:considersOption <urn:usf:realisationoption:authenticatedcheckpointcoldarchiveboundedhottail>, <urn:usf:realisationoption:genesisreplayhotstoreonly>;
    usf:selectsOption <urn:usf:realisationoption:authenticatedcheckpointcoldarchiveboundedhottail>;
    usf:hasDecisionEvaluation <urn:usf:decisionevaluation:backupandrestoreeventhistorycheckpointpruning>;
    usf:decisionRationale "The authenticated-checkpoint option bounds routine verification cost while preserving exact signed cold history, genesis restoration, checkpoint-plus-tail projection equivalence and fail-closed activation; the hot-store-only option preserves truth but retains the demonstrated unbounded operational cost.";
    usf:authorisesRepository "maldous/usf-factory";
    usf:authorisesSourcePath
