# Exact V2 native publisher identity.  The V2 native handover folds the publisher's command
# and implementation identity into the coordination identity digest and the 16-field terminal
# receipt, so that identity is declared and digest bound here and resolved from live
# authority at publication time - never asserted by whoever runs the publication.  It is a
# usf:PublisherImplementation rather than a usf:ProofAlgorithm because the publisher lives
# under processes/ and the proof-algorithm space stays restricted to assurance/.  The command
# digest is the exact committed bytes of the command module; the implementation source set
# digest is sha256(canonicalJson([{path, digest, byteSize}, ...])) over the enumerated
# modules, the framing already used for every implementation source set digest in this model.
<urn:usf:publisherimplementation:nativev2publisher> a usf:PublisherImplementation;
  usf:canonicalName "nativev2publisher";
  usf:publisherSourcePath "processes/semantic-assurance/semantic-authority-publication.mjs";
  usf:publisherCommandDigest "sha256:f7d273c3ed046e85bc81fbdfcd07ea893ede424dbd37c07b158dcfea98204dba";
  usf:publisherImplementationSourcePath
    "processes/semantic-assurance/semantic-authority-publication.mjs",
    "processes/semantic-assurance/semantic-model-compilation-command.mjs",
    "processes/semantic-assurance/semantic-proof-v2.mjs";
  usf:publisherImplementationSourceSetDigest "sha256:92d115f5af8e60f4fae1a1c0e8dc5a154846cba4d42a757a64d1ef9b5f543e7a".
# Exact Factory-side native V2 closure executor identity.  The V2 coordination identity and the
# 16-field terminal receipt record which Factory executor performed the closure, so that identity
# is declared and digest bound here and resolved from live authority at publication time.  It is a
# usf:ClosureExecutorImplementation rather than a usf:PublisherImplementation because the executor
# lives under src/ in maldous/usf-factory: the publisher's processes/** scope is untouched, and no
# proof algorithm is involved.  The implementation set is the production native-handover closure
# call graph - the command entrypoint, the closure state machine and durable closure store, the
# Graph ownership/reservation observation and authorization resolution, the canonical digest
# framing, and the loader the closure spawns to read the Graph - and its digest uses the
# established sha256(canonicalJson([{path, digest, byteSize}, ...])) framing over the exact
# protected Factory commit bytes.
<urn:usf:closureexecutorimplementation:factorynativev2closureexecutor>
  a usf:ClosureExecutorImplementation;
  usf:canonicalName "factorynativev2closureexecutor";
  usf:closureExecutorRepository "maldous/usf-factory";
  usf:closureExecutorSourceCommit "654ee7cb1aeda8b6b5d2c4cce43efe5d0ffb2828";
  usf:closureExecutorSourceTree "9a1b6d29dd52fcc4a1618e6ff2fe373530962efc";
  usf:closureExecutorCommandPath "src/usf_factory/cli.py";
  usf:closureExecutorCommandDigest
    "sha256:cc2c03d37183480221373dbd23765db16b067cd5dd9adba856c33bcd586f06cf";
  usf:closureExecutorImplementationSourcePath
    "src/usf_factory/activation.py",
    "src/usf_factory/canonical.py",
    "src/usf_factory/cli.py",
    "src/usf_factory/context.py",
    "src/usf_factory/graph_reader_entrypoint.mjs";
  usf:closureExecutorImplementationSourceSetDigest
    "sha256:4c8b3747cf07bca7889d16c30ae46ae1712717410a1ee4c7d629b4c541ec04b4".
# Exact evidence-admission producer identity for the validation-currentness renewal rule.  Live
# authority carried no digest-bound identity denoting this producer: usf:evidenceProducerDigest
# exists but not for evidenceresult:compilerhermeticsubstituteruntime, and neither
# usf:evaluationProducerDigest nor the validation-evidence subjects carry one.  The identity digest
# is the producer's own implementation source set digest over the paths authority already declares
# for it, because its source scope digest is shared with the evidence admission path and the
# validation binding and so does not identify a producer.
<urn:usf:evidenceadmissionproduceridentity:compilersemanticenforcementaggregateevidenceadmissionproducer>
  a usf:EvidenceAdmissionProducerIdentity;
  usf:canonicalName "compilersemanticenforcementaggregateevidenceadmissionproducer";
  # Recorded as exact identifier strings, not IRI references: both subjects are produced by
  # the compiler into live authority and are not declared in the authored model, so an IRI
  # reference here is an unresolved reference in the authored closure.
  usf:admissionProducerValidationProducer
    "urn:usf:validationproducer:compilersemanticenforcementaggregate";
  usf:admissionProducerEvidenceAdmissionPath
    "urn:usf:evidenceadmissionpath:compilersemanticenforcementaggregate";
  usf:admissionProducerRepository "maldous/usf-graph";
  usf:admissionProducerSourceScopeDigest
    "sha256:7d5a49a02c8d8194b42a70d21cb6f96733c5f53be23d78246db0374a1f15ec8e";
  usf:admissionProducerImplementationSourcePath
    "assurance/permutation-closure/foundation-domain-closure.test.mjs",
    "assurance/permutation-closure/foundation-gap-remediation.mjs",
    "assurance/semantic-model-compilation/aggregate-compiler-authority-candidate.mjs",
    "assurance/semantic-model-compilation/aggregate-compiler-authority-candidate.test.mjs",
    "assurance/semantic-model-compilation/aggregate-compiler-proof-command.mjs",
    "assurance/semantic-model-compilation/aggregate-compiler-proof-command.test.mjs",
