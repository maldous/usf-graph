# Exact Factory Provider V3 implementation proof.  The proof is deliberately
# attached only to providerconfigurationplane; it does not promote any generic
# platform contract or future implementation generation.
<urn:usf:proofalgorithm:factoryproviderv3implementation> a usf:ProofAlgorithm;
  usf:canonicalName "factoryproviderv3implementation";
  usf:proofAlgorithmSourcePath "assurance/semantic-model-compilation/aggregate-compiler-proof.mjs";
