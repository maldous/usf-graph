@prefix usf: <urn:usf:ontology:>.
@prefix gcl: <urn:usf:graphclass:>.
@prefix ng: <urn:usf:namedgraph:>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<urn:usf:authority:validatedsemanticstate> a usf:SemanticAuthority;
    usf:canonicalName "validatedsemanticstate";
    usf:soleSemanticAuthority true;
    usf:validatedInStardog true;
    usf:defaultReasoningSchemaGraph ng:ontology, ng:taxonomy;
    usf:authorityVerificationState "validator-and-shacl-conformant".
gcl:definitiongraph usf:mayDeclareTerms true;
    usf:mayAssertInstances true;
    usf:authoritative false;
    usf:loadedAsAuthority true;
    usf:mayReference gcl:definitiongraph.
gcl:authoredgraph usf:mayDeclareTerms false;
    usf:mayAssertInstances true;
    usf:authoritative false;
    usf:loadedAsAuthority true;
    usf:mayReference gcl:definitiongraph, gcl:authoredgraph.
gcl:shapegraph usf:mayDeclareTerms false;
    usf:mayAssertInstances false;
    usf:authoritative false;
    usf:loadedAsAuthority true;
    usf:mayConstrain gcl:definitiongraph, gcl:authoredgraph, gcl:derivedgraph;
    usf:mayReference gcl:definitiongraph, gcl:authoredgraph, gcl:derivedgraph.
gcl:rulegraph usf:mayDeclareTerms false;
    usf:mayAssertInstances false;
    usf:authoritative false;
    usf:loadedAsAuthority true;
    usf:mayDerive gcl:derivedgraph;
    usf:mayReference gcl:definitiongraph, gcl:authoredgraph, gcl:derivedgraph.
gcl:derivedgraph usf:mayDeclareTerms false;
    usf:mayAssertInstances true;
    usf:authoritative false;
    usf:loadedAsAuthority true;
    usf:mayReference gcl:definitiongraph, gcl:authoredgraph, gcl:derivedgraph.
gcl:fixturegraph usf:mayDeclareTerms false;
    usf:mayAssertInstances true;
    usf:authoritative false;
    usf:loadedAsAuthority false;
    usf:mayReference gcl:definitiongraph.
gcl:observedgraph usf:mayDeclareTerms false;
    usf:mayAssertInstances true;
    usf:authoritative false;
    usf:loadedAsAuthority false;
    usf:loadedForValidation true;
    usf:loadedForDerivation true;
    usf:mayReference gcl:definitiongraph, gcl:authoredgraph, gcl:observedgraph.
gcl:shapegraph usf:mayConstrain gcl:observedgraph;
    usf:mayReference gcl:observedgraph.
gcl:rulegraph usf:mayReference gcl:observedgraph.
gcl:derivedgraph usf:mayReference gcl:observedgraph.

# The graph records scoped assignments and signed-envelope digests. It does not
# establish its own trust: the authoritative fingerprint is pinned in the
# root-owned Semantic Proof Protocol v1 trust anchor.
<urn:usf:semanticproofprotocol:v1> a <urn:usf:ontology:SemanticProofProtocol>;
    <urn:usf:ontology:canonicalName> "v1";
    <urn:usf:ontology:protocolIdentifier> "semantic-proof-v1";
    <urn:usf:ontology:signatureAlgorithm> "openpgp";
    <urn:usf:ontology:approvalThreshold> 1.
<urn:usf:signingtrustclass:semanticauthority> a <urn:usf:ontology:SigningTrustClass>;
    <urn:usf:ontology:canonicalName> "semanticauthority".
<urn:usf:signingtrustclass:integrityonly> a <urn:usf:ontology:SigningTrustClass>;
    <urn:usf:ontology:canonicalName> "integrityonly".
<urn:usf:principal:matthewaldous> a <urn:usf:ontology:SemanticAuthorityPrincipal>;
    <urn:usf:ontology:canonicalName> "matthewaldous";
    <urn:usf:ontology:definition> "Matthew Aldous, GitHub principal maldous, authoritative semantic owner.";
    <urn:usf:ontology:githubPrincipal> "maldous".
<urn:usf:signingidentity:matthewaldoussemanticproofv1> a <urn:usf:ontology:SemanticAuthoritySigningIdentity>;
    <urn:usf:ontology:canonicalName> "matthewaldoussemanticproofv1";
    <urn:usf:ontology:authorityPrincipal> <urn:usf:principal:matthewaldous>;
    <urn:usf:ontology:signingTrustClass> <urn:usf:signingtrustclass:semanticauthority>;
    <urn:usf:ontology:signingKeyFingerprint> "B6CBC89C7978AF26F53C33A197E5F20D2A340E5D";
    <urn:usf:ontology:signatureAlgorithm> "openpgp".

# V2 native handover vocabulary is declared in this registered definition graph.
# The live D1/D2 authority may assert only instances of these terms.  The D2
# fence intentionally remains pending: terminal ownership is the non-cyclic
# conjunction of that immutable fence, the exact two Graph-native successor
# readbacks and the admitted terminal receipt consumed by Factory activation.
usf:V2NativeHandoverFence a owl:Class;
    rdfs:label "V2 native handover fence";
    rdfs:comment "The single immutable Graph authority fence for one V2 native handover generation; its presence retires current V1 publication and never by itself establishes terminal V2 ownership.";
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.
usf:V2NativeGraphSuccessorBinding a owl:Class;
    rdfs:label "V2 native Graph successor binding";
    rdfs:comment "One exact consumer-to-Graph-storage-owner binding in the fenced handover generation; native payload identity is proved through typed CAS and the production reader, not by a predecessor V1 IRI.";
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.
usf:V2NativeValidationCurrentnessHead a owl:Class;
    rdfs:label "V2 native validation currentness head";
    rdfs:comment "The current member of a V2 native validation-currentness lineage. It is the terminal-V2 anchor of a contract execution scope, occupying the role a V1 ProofResult occupies before the handover; it is a native record proved through typed CAS and the production reader, never a projection or translation of a V1 proof result.";

usf:V2NativeOwnershipState a owl:Class;
    rdfs:label "V2 native ownership state";
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.
usf:V1CurrentPublicationState a owl:Class;
    rdfs:label "V1 current publication state";
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.
usf:V2NativeStorageOwner a owl:Class;
    rdfs:label "V2 native storage owner";
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.

usf:handoverGenerationDigest a owl:DatatypeProperty, owl:FunctionalProperty;
    rdfs:range xsd:string;
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.
usf:handoverOwnershipState a owl:ObjectProperty, owl:FunctionalProperty;
    rdfs:domain usf:V2NativeHandoverFence;
    rdfs:range usf:V2NativeOwnershipState;
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.
usf:handoverCurrentV1PublicationState a owl:ObjectProperty, owl:FunctionalProperty;
    rdfs:domain usf:V2NativeHandoverFence;
    rdfs:range usf:V1CurrentPublicationState;
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.
usf:handoverReleaseSubjectDigest a owl:DatatypeProperty, owl:FunctionalProperty;
    rdfs:domain usf:V2NativeHandoverFence;
    rdfs:range xsd:string;
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.
usf:handoverD0AuthorityDigest a owl:DatatypeProperty, owl:FunctionalProperty;
    rdfs:domain usf:V2NativeHandoverFence;
    rdfs:range xsd:string;
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.
usf:handoverDerivedConsumerRegistryDigest a owl:DatatypeProperty, owl:FunctionalProperty;
    rdfs:domain usf:V2NativeHandoverFence;
    rdfs:range xsd:string;
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.
usf:handoverExternalAttestationSetRootDigest a owl:DatatypeProperty, owl:FunctionalProperty;
    rdfs:domain usf:V2NativeHandoverFence;
    rdfs:range xsd:string;
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.
usf:handoverFactorySourceTree a owl:DatatypeProperty, owl:FunctionalProperty;
    rdfs:domain usf:V2NativeHandoverFence;
    rdfs:range xsd:string;
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.
usf:handoverGraphSourceTree a owl:DatatypeProperty, owl:FunctionalProperty;
    rdfs:domain usf:V2NativeHandoverFence;
    rdfs:range xsd:string;
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.
usf:handoverExpectedTerminalReceiptSchema a owl:DatatypeProperty, owl:FunctionalProperty;
    rdfs:domain usf:V2NativeHandoverFence;
    rdfs:range xsd:string;
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.
usf:handoverGraphNativeSuccessorBinding a owl:ObjectProperty;
    rdfs:domain usf:V2NativeHandoverFence;
    rdfs:range usf:V2NativeGraphSuccessorBinding;
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.
usf:handoverGraphNativeConsumer a owl:ObjectProperty, owl:FunctionalProperty;
    rdfs:domain usf:V2NativeGraphSuccessorBinding;
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.
usf:handoverStorageOwner a owl:ObjectProperty, owl:FunctionalProperty;
    rdfs:domain usf:V2NativeGraphSuccessorBinding;
    rdfs:range usf:V2NativeStorageOwner;
    usf:termUsageState <urn:usf:termusagestate:usedbysemanticquery>.

<urn:usf:v2ownershipstate:handoverpending> a usf:V2NativeOwnershipState;
    usf:canonicalName "handoverpending";
    rdfs:comment "Irreversible current-publication fence. Runtime is recovery-required until the exact terminal receipt and Factory activation complete the native ownership conjunction.".
<urn:usf:v1publicationstate:fenced> a usf:V1CurrentPublicationState;
    usf:canonicalName "fenced";
    rdfs:comment "Current V1 publication is deterministically rejected. Historical V1 verification remains proof-only.".
<urn:usf:v2nativeowner:graph> a usf:V2NativeStorageOwner;
    usf:canonicalName "graph".
